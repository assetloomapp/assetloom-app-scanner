{
  "name": "assetloom-app-scanner",
  "version": "0.1.0",
  "description": "Scan your IdP for third-party OAuth app grants. Find AI apps and risky permissions.",
  "keywords": [
    "oauth",
    "google-workspace",
    "shadow-it",
    "security",
    "saas",
    "audit",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assetloomapp/assetloom-app-scanner.git"
  },
  "homepage": "https://github.com/assetloomapp/assetloom-app-scanner#readme",
  "bugs": {
    "url": "https://github.com/assetloomapp/assetloom-app-scanner/issues"
  },
  "type": "module",
  "bin": {
    "assetloom-app-scanner": "./src/cli.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "gen": "node scripts/embed-template.ts",
    "build": "pnpm gen && bun build --compile src/cli.ts --outfile dist/assetloom-app-scanner",
    "build:sea": "pnpm gen && bash scripts/build-sea.sh",
    "test": "node --test",
    "release": "git tag \"v$npm_package_version\" && git push origin \"v$npm_package_version\"",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "googleapis": "^175.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
